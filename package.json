{
  "name": "gh-media-attach",
  "version": "0.2.0",
  "description": "Attach videos and images to GitHub issues, PRs and comments with a personal access token",
  "keywords": [
    "github",
    "video",
    "image",
    "media",
    "attachment",
    "upload",
    "user-attachments",
    "markdown",
    "cli"
  ],
  "license": "MIT",
  "author": "mimo-3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimo-3/gh-media-attach.git"
  },
  "bugs": {
    "url": "https://github.com/mimo-3/gh-media-attach/issues"
  },
  "homepage": "https://github.com/mimo-3/gh-media-attach#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gh-media-attach": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node --eval \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "verify": "npm test",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
